# Supabase (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Public origin used for links in auth email (confirmation, recovery, resend).
# In Vercel set it for Production only — leave it unset in Preview so each
# preview deployment uses its own VERCEL_URL. When it is unset the request's
# forwarded headers are used, then localhost for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only, tests/seed only — NEVER expose to the client
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# AI (server-only, never NEXT_PUBLIC_). Read lazily: with no key the weekly
# summary answers with a setup message instead of failing the page.
AI_API_KEY=
# Any OpenAI-compatible endpoint. Gemini's compatibility layer:
AI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gpt-4o-mini

# CLI / RLS test runner (local first)
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Playwright (optional overrides)
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Auth email: Supabase Send Email Hook → our own templates (src/lib/email)
# Secret from Auth Hooks in the dashboard; keep the v1,whsec_ prefix.
SEND_EMAIL_HOOK_SECRET=v1,whsec_YOUR_WEBHOOK_SECRET
# Gmail now, any SMTP provider later.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_SENDER@gmail.com
# Google app password (16 chars), not the account password.
SMTP_PASSWORD=YOUR_APP_PASSWORD
EMAIL_FROM=YOUR_SENDER@gmail.com
EMAIL_FROM_NAME=MediDose
